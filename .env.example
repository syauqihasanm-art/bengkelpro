# ==============================================================================
# BENGKELPRO ENVIRONMENT CONFIGURATION
# Copy this file to .env.local for local development.
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000

# Supabase Managed Database & Auth (Mandatory)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Gemini AI Engine (Optional - automotive diagnosis & marketing assistance)
GEMINI_API_KEY=

# Midtrans Payment Gateway (Optional - QRIS & Bank Transfer integration)
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# Transactional Email Notification (Optional)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=notifikasi@bengkelpro.id

# WhatsApp Business API Notification (Optional)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Application Monitoring (Optional)
SENTRY_DSN=
